{
  "mcpServers": {
    "cutmaster-ai": {
      "command": "uv",
      "args": ["run", "python", "-m", "cutmaster_ai"]
    },
    "mcp-playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "davinci-resolve": {
      "command": "/home/user/.local/share/davinci-resolve-mcp/venv/bin/python",
      "args": ["/home/user/.local/share/davinci-resolve-mcp/src/server.py"]
    }
  }
}
